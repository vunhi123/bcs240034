@model MID_BCS240034.Models.Event_BCS240034
@{
    ViewData["Title"] = "Chi tiết sự kiện";
}

<div class="card">
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>

        <div class="row">
            <div class="col-md-5">
                @{
                    var thumb = Model.EventImages?.FirstOrDefault(i => i.IsThumbnail) ?? Model.EventImages?.FirstOrDefault();
                }
                @if (thumb != null)
                {
                    <img src="@thumb.ImageUrl" class="img-fluid rounded mb-3" />
                }
            </div>
            <div class="col-md-7">
                <dl class="row">
                    <dt class="col-sm-4">Loại</dt>
                    <dd class="col-sm-8">@Model.EventCategory?.Name</dd>

                    <dt class="col-sm-4">Giá</dt>
                    <dd class="col-sm-8">@String.Format("{0:N0}", Model.Price) đ</dd>

                    <dt class="col-sm-4">Địa điểm</dt>
                    <dd class="col-sm-8">@Model.Location</dd>

                    <dt class="col-sm-4">Thời gian</dt>
                    <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">
                        @if(DateTime.Now < Model.StartDate)
                        {
                            <span class="badge bg-warning">Sắp diễn ra</span>
                        }
                        else if(DateTime.Now > Model.EndDate)
                        {
                            <span class="badge bg-danger">Đã kết thúc</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Đang diễn ra</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Mô tả</dt>
                    <dd class="col-sm-8">@Model.Description</dd>
                </dl>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>
