@model IEnumerable<MID_BCS240034.Models.EventImage_BCS240034>
@{
    ViewData["Title"] = "Ảnh sự kiện";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>ẢNH SỰ KIỆN</h2>
    <a class="btn btn-primary" asp-controller="Event_BCS240034" asp-action="Index">Quay lại sự kiện</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Event</th>
            <th>Ảnh</th>
            <th>Thumbnail</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Event?.Name</td>
            <td><img src="@item.ImageUrl" width="150" class="img-fluid rounded" /></td>
            <td>@(item.IsThumbnail ? "Yes" : "No")</td>
            <td>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
