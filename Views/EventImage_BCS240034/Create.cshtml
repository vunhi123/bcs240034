@model MID_BCS240034.Models.EventImage_BCS240034
@{
    ViewData["Title"] = "Thêm ảnh";
}

<div class="card shadow">
    <div class="card-body">
        <h3 class="card-title mb-3">THÊM ẢNH</h3>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <input type="hidden" name="EventId" value="@ViewData["EventId"]" />

            <div class="mb-3">
                <label class="form-label">Upload image file</label>
                <input type="file" name="ImageFile" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label">Or provide Image URL</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsThumbnail" class="form-check-input" />
                <label asp-for="IsThumbnail" class="form-check-label">Set as thumbnail</label>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-controller="Event_BCS240034" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
