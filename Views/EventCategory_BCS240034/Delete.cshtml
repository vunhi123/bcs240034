@model MID_BCS240034.Models.EventCategory_BCS240034
@{
    ViewData["Title"] = "Xóa loại";
}

<div class="card">
    <div class="card-body">
        <h3>Xóa loại sự kiện</h3>
        <p>Bạn có chắc muốn xóa loại <strong>@Model.Name</strong> không?</p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
