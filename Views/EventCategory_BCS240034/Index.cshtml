@model IEnumerable<MID_BCS240034.Models.EventCategory_BCS240034>
@{
    ViewData["Title"] = "Loại sự kiện";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Loại sự kiện</h2>
    <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Mô tả</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">Detail</a>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
